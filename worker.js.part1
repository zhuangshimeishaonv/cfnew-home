    const 基础 = 获取值节点别名基础(项目778);
    if (跳过编号779) return 基础;
    计数器组[基础] = (计数器组[基础] || 0) + 1;
    return `${基础}-${String(计数器组[基础]).padStart(2, '0')}`;
  };
}
function 规范化应用层协议协商(值777) {
