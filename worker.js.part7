  async function 测试延迟(主机, 端口, 信号) {
    const 超时 = 8000;
    let 机房 = '';
    let 测试网址 = '';
    try {
      const 控制器 = new AbortController();
      const 超时标识 = setTimeout(() => 控制器.abort(), 超时);
      if (信号) {
