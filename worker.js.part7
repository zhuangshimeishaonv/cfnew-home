  // 城市筛选相关函数
  const 城市筛选值 = document.getElementById('cityFilterContainer');
  const 城市值值 = document.getElementById('cityCheckboxesContainer');
  function 更新城市筛选() {
    if (!城市筛选值 || !城市值值) return;

    // 从测试结果中提取所有可用的城市
    const 城市映射 = new Map();
    测试结果列表.forEach((结果20017, 索引20016) => {
